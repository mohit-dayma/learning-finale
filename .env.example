# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.
#
# Get these from your Neon project dashboard
# (https://console.neon.tech → your project → Connection Details):
#
# DATABASE_URL — pooled connection (PgBouncer). Use this for the
#   application at runtime. Must include `?sslmode=require`.
#   Example:
#   DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
#
# DIRECT_URL — direct (non-pooled) connection. Used by Prisma for
#   migrations (`prisma migrate dev`, `prisma db push`), which cannot
#   run through a connection pooler. Must include `?sslmode=require`.
#   Example:
#   DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<dbname>?sslmode=require"

DATABASE_URL="postgresql://user:password@localhost:5432/learning?sslmode=require&schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/learning?sslmode=require&schema=public"
