# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# This project reads ONLY the three variables below.
# Nothing in the codebase reads DIRECT_URL — do not add it.

# DATABASE_URL — the single Postgres connection string used by the app
# runtime (src/lib/db.ts), Prisma migrations (prisma7.config.ts), and the
# seed script (prisma/seed.ts). Must include `?sslmode=require` for Neon.
#
# Pooled vs direct (Neon):
# - Runtime (Vercel / Node server): use the POOLED URL (hostname contains
#   `-pooler`). Serverless runtimes open many short-lived connections and
#   need the pooler.
#     DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
# - Migrations (`prisma migrate deploy`): PgBouncer in transaction mode can
#   break DDL, so run migrations against the DIRECT (non-pooled) URL by
#   overriding the same variable for that one command:
#     DATABASE_URL="<direct-url>?sslmode=require" pnpm exec prisma migrate deploy
# - Local dev against local Postgres:
#     DATABASE_URL="postgresql://user:password@localhost:5432/learning?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/learning?sslmode=require"

# BETTER_AUTH_SECRET — server-only signing secret for Better Auth sessions.
# Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-to-a-32-byte-base64-secret"

# BETTER_AUTH_URL — canonical public URL of the app in the current env.
# Local:      "http://localhost:3000"
# Production: "https://your-app.vercel.app" (must match the deployed URL,
#             or auth callbacks/cookies break after deploy)
BETTER_AUTH_URL="http://localhost:3000"
